# ==========================================
# Deeper Watchdog: конфигурация
# Скопируйте этот файл в .env и заполните. Файл .env не публикуется (см. .gitignore)
# ==========================================

# IP-адрес Deeper Connect в вашей сети
DEEPER_HOST=34.34.34.34

# Логин и пароль от веб-панели Deeper Connect
DEEPER_USER=admin
DEEPER_PASS=

# Список туннелей для мониторинга через запятую, например US,GB,NL
# Оставьте пустым, если хотите отслеживать вообще все активные туннели
MONITOR_TUNNELS=

# Порог максимальной задержки в миллисекундах
MAX_LATENCY_MS=2500

# Сколько неудачных проверок туннеля подряд нужно до смены ноды (перестроение — последнее средство)
FAIL_THRESHOLD=2

# Интервал проверки туннелей в секундах (180 сек = 3 минуты)
CHECK_INTERVAL=180

# Часовой пояс
TZ=Europe/Moscow

# ==========================================
# Тестовые сайты задаются в веб-интерфейсе: Настройки → Тестовые сайты.
# Каждый сайт проверяет тот туннель, через который сейчас идёт его домен.
# ==========================================

# ==========================================
# Настройки отправки уведомлений на почту (SMTP)
# ==========================================

# Включить отправку писем (true / false)
SMTP_ENABLED=false

# SMTP-сервер:
# Для Yandex:  smtp.yandex.ru  (порт 465, SSL: true)
# Для Mail.ru: smtp.mail.ru    (порт 465, SSL: true)
# Для Gmail:   smtp.gmail.com  (порт 465, SSL: true или 587, SSL: false)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true

# Логин и пароль приложения (App Password):
# Внимание: современные почтовые сервисы требуют создавать специальный
# "Пароль приложения" в настройках безопасности аккаунта почты!
SMTP_USER=
SMTP_PASS=

# От кого отправлять (обычно совпадает с SMTP_USER)
SMTP_FROM=

# Куда отправлять уведомления (ваш адрес почты)
SMTP_TO=

# ==========================================
# Веб-интерфейс настроек (http://IP-сервера:8787)
# Значения, сохранённые в веб-интерфейсе, хранятся в data/settings.json
# и имеют приоритет над этим файлом. Кнопка «Сброс настроек» удаляет их.
# ==========================================
WEB_ENABLED=true
WEB_PORT=8787
# Пароль веб-интерфейса. Обычно оставьте пустым: его попросит задать первая открытая страница,
# и каждое устройство введёт его один раз. Если задать здесь, он меняется только в этом файле.
WEB_PASSWORD=
